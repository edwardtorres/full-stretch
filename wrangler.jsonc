{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fullstretch-edward-torres",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "fullstretch.edwardtorres.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  }
}
